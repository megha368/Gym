# Copy this file to .env (which git ignores) and choose your own values:
#     cp .env.example .env
#
# SQL Server rejects weak passwords: at least 8 characters, with upper case, lower case
# and digits. Use only letters, digits and _ : the passwords also go inside connection
# URLs, where symbols would need escaping.

MSSQL_SA_PASSWORD=ChangeMe_Admin_2026
SCHEDULING_DB_PASSWORD=ChangeMe_Sched_2026
BOOKINGS_DB_PASSWORD=ChangeMe_Book_2026

# Signs login tokens. Any long random string, for example the output of:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOOKINGS_SECRET_KEY=change-me-to-a-long-random-string
